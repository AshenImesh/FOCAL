# ═══════════════════════════════════════════════════════════════
#  FOCAL — Environment setup
#  Copy this file to `.env.local` and fill in your real values,
#  then set the SAME values in your Vercel project → Settings →
#  Environment Variables (for production).
# ═══════════════════════════════════════════════════════════════

# ── 1. Create a Supabase project at https://supabase.com ─────────
#    Dashboard → Project Settings → API  (copy these three)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── 2. Run the SQL in supabase/schema.sql ────────────────────────
#    Dashboard → SQL Editor → paste the file → Run
#    This creates the tables, row-level security and the approval guard.

# ── 3. Enable Google sign-in ─────────────────────────────────────
#    Dashboard → Authentication → Providers → Google → Enable
#    Fill in the Google Client ID / Secret from
#    https://console.cloud.google.com (create an OAuth consent screen,
#    then an OAuth 2.0 Client ID of type "Web application").
#    Add your site URL to the allowed redirect URLs:
#      http://localhost:3000/auth/callback      (local dev)
#      https://YOUR-VERCEL-APP.vercel.app/auth/callback   (production)

# ── 4. The Gmail address that OWNS the admin control panel ─────────
#    This account can open /admin. More admins can be added any time
#    from inside the panel (Admins section) — no redeploy needed.
ADMIN_EMAIL=youremail@gmail.com

# ── 5. Secret used to sign teacher-panel login tokens ────────────
#    Any long random string (e.g. a UUID from https://www.uuidgenerator.net)
SESSION_SECRET=change-this-to-a-long-random-string
